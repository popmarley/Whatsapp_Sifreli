<Window x:Class="Whatsapp_Sifreli.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WhatsApp Web"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="1200" Height="800">



    <Border Background="#101316" CornerRadius="14" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Üst başlık -->
            <Grid Background="#151B20" Height="48" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="WhatsApp Web"
                           VerticalAlignment="Center" Margin="16,0"
                           Foreground="#EDEDED" FontSize="14" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="—" Width="40" Height="28" Margin="0,0,6,0"
                            Click="Minimize_Click"
                            Background="#222C34" Foreground="#EDEDED" BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="✕" Width="40" Height="28"
                            Click="Close_Click"
                            Background="#C8464B" Foreground="White" BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- WebView2 -->
            <Border Grid.Row="1" CornerRadius="10" Margin="8" Background="#0E1114">
                <wv2:WebView2 x:Name="webView" />
            </Border>
        </Grid>
    </Border>
</Window>
